# Application
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://carepath_user:carepath_secret@localhost:5432/carepath_db?schema=public

# JWT Security
JWT_ACCESS_SECRET=carepath_jwt_access_secret_super_secure_key_change_in_production_12345
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=carepath_jwt_refresh_secret_super_secure_key_change_in_production_67890
JWT_REFRESH_EXPIRATION=7d

# S3 / MinIO Object Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=carepath-medical-vault
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_EXPIRATION=900

# Redis (BullMQ / Async Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
